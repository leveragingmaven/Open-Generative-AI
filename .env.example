# MuAPI
# Server-only MuAPI credential used by Creative Studio proxy routes.
# Do not create NEXT_PUBLIC_ or VITE_ MuAPI key variables.
MUAPI_API_KEY=
MUAPI_BASE_URL=https://api.muapi.ai

# Creator OS structured text intelligence (server-only, OpenAI-compatible).
# The endpoint must expose /chat/completions and the selected model must support
# strict response_format json_schema output. These calls prepare creative work;
# they do not execute media generation and must never use NEXT_PUBLIC_ variables.
OPENAI_COMPATIBLE_BASE_URL=
MAVENSYNC_OPENAI_MODEL=
OPENAI_API_KEY=
# Existing compatibility aliases: OPENAI_BASE_URL, OPENAI_MODEL,
# MAVENSYNC_OPENAI_API_KEY.

# MuAPI Publishing
# Social publishing remains MuAPI-backed and server-side.
# No browser-safe MuAPI publishing secrets should be added.

# Agency Mode
AGENCY_MODE=true
AGENCY_ALLOWED_ORIGINS=
CREATIVE_STUDIO_TABS=image,video,marketing,ai-influencer,ai-twin,design-agent,workflows,audio,lipsync,character,publishing,asset-library,campaigns,knowledge-center,memory,cinema,clipping,vibe-motion
# Image Studio Creative OS runtime cutover. Keep disabled for legacy behavior; enable after parity validation.
CREATIVE_OS_IMAGE_STUDIO=false
# Marketing Studio Creative OS runtime cutover. Keep disabled for legacy behavior until parity validation.
CREATIVE_OS_MARKETING_STUDIO=false
CREATIVE_OS_CINEMA_STUDIO=false
CREATIVE_OS_VIDEO_STUDIO=false
CREATIVE_OS_LIPSYNC_STUDIO=false
CREATIVE_OS_AUDIO_STUDIO=false
CREATIVE_OS_RECAST_STUDIO=false
CREATIVE_OS_VIBE_MOTION_STUDIO=false
CREATIVE_OS_AI_INFLUENCER_STUDIO=false
CREATIVE_OS_WORKFLOW_STUDIO=false

# MavenSync Hub integration (browser-safe configuration)
# Use NEXT_PUBLIC_* for the Next.js Creative Studio deployment.
NEXT_PUBLIC_MAVENSYNC_MODE=standalone
NEXT_PUBLIC_MAVENSYNC_API_BASE=
NEXT_PUBLIC_MAVENSYNC_ALLOWED_RETURN_ORIGINS=https://hub.mavensync.space

# Optional Vite/Electron-compatible aliases for legacy builds only.
VITE_MAVENSYNC_MODE=standalone
VITE_MAVENSYNC_API_BASE=
VITE_MAVENSYNC_ALLOWED_RETURN_ORIGINS=https://hub.mavensync.space

# MavenSync server-only credentials, if a future server-side bridge needs them.
# Never expose server-only secrets with NEXT_PUBLIC_ or VITE_ prefixes.
MAVENSYNC_API_SECRET=

# Harness-to-Creator signed service authentication. Configure the same current
# secret in Harness; retain PREVIOUS only during a controlled rotation window.
MAVENSYNC_SERVICE_AUTH_SECRET=
MAVENSYNC_SERVICE_AUTH_SECRET_PREVIOUS=

# AI-gency signed SSO contract (server-only; never use NEXT_PUBLIC_*).
MAVENSYNC_SSO_SECRET=
MAVENSYNC_SSO_ISSUER=ai-gency
MAVENSYNC_SSO_AUDIENCE=mavensync-creator-os

# Creator persistence. Run `npm run migrate` before readiness is enabled.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=

# Encrypts account-scoped provider credentials at rest. Use a high-entropy
# deployment secret and back it up; changing it makes stored credentials unreadable.
MAVENSYNC_CREDENTIAL_ENCRYPTION_KEY=

# Hosts whose HTTPS asset URLs Creator may verify. Comma-separated exact hosts
# or controlled wildcards such as *.cdn.example.com. Never add localhost/private hosts.
MAVENSYNC_ASSET_HOST_ALLOWLIST=

# Process-local paid-route abuse protection. Agency-funded limits are stricter.
CREATOR_OS_AGENCY_RATE_LIMIT_PER_MINUTE=60
CREATOR_OS_AGENCY_RATE_LIMIT_BURST=12
CREATOR_OS_AGENCY_RATE_LIMIT_BURST_WINDOW_SECONDS=10
CREATOR_OS_BYOK_RATE_LIMIT_PER_MINUTE=120
CREATOR_OS_BYOK_RATE_LIMIT_BURST=20
CREATOR_OS_BYOK_RATE_LIMIT_BURST_WINDOW_SECONDS=10

# Server-side upload limits. Values are megabytes and apply before upstream forwarding.
CREATOR_OS_UPLOAD_MAX_IMAGE_MB=25
CREATOR_OS_UPLOAD_MAX_AUDIO_MB=100
CREATOR_OS_UPLOAD_MAX_VIDEO_MB=500
CREATOR_OS_UPLOAD_MAX_REQUEST_MB=512
